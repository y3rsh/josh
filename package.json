{
  "name": "josh",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync:github": "node scripts/sync-github-projects.mjs",
    "sync:prs": "node scripts/sync-opentrons-prs.mjs",
    "resume:pdf": "node scripts/generate-resume-pdf.mjs",
    "setup:redirects": "node scripts/setup-zone-redirects.mjs",
    "dev": "astro dev",
    "typecheck": "astro check",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "validate": "pnpm typecheck && pnpm lint",
    "build": "pnpm validate && astro build",
    "preview": "astro preview",
    "preview:cf": "astro build && wrangler pages dev ./dist",
    "deploy:cf": "astro build && wrangler pages deploy ./dist",
    "check": "pnpm validate",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^6.3.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^25.9.1",
    "pdfkit": "^0.19.1",
    "typescript": "6.0.0-beta",
    "wrangler": "^4.94.0"
  }
}
