---
import CareerMap from '../components/CareerMap.astro';
import { careerMap } from '../content/career-map';
import { aiSection, contactSection, experience, facets, hero } from '../content/site-copy';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site';

// Download filename carries the current year, resolved at site build time.
const resumeDownloadName = `JoshMcVeyResume${new Date().getFullYear()}.pdf`;
---

<BaseLayout>
  <section class="hero" id="top">
    <p class="eyebrow">{hero.eyebrow}</p>
    <h1>{hero.headline}</h1>
    <p class="lede">{hero.lede}</p>
  </section>

  <section class="section" id="good-at" aria-labelledby="good-at-title">
    <h2 id="good-at-title">{facets.title}</h2>
    <p class="section-intro">{facets.intro}</p>
    <div class="facet-grid">
      {
        facets.items.map((item) => (
          <article class="facet">
            {item.heading && <h3>{item.heading}</h3>}
            <p>{item.body}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section career-section" id="career" aria-labelledby="career-title">
    <h2 id="career-title">{careerMap.title}</h2>
    <p class="section-intro">{careerMap.intro}</p>
    <CareerMap />
  </section>

  <section class="section experience-section" id="experience" aria-labelledby="experience-title">
    <h2 id="experience-title">{experience.title}</h2>
    <ol class="timeline-compact">
      {
        experience.roles.map((role) => (
          <li class="timeline-card" style={`--role-accent: ${role.accent}`}>
            <div class="timeline-card-head">
              <div class="timeline-card-titles">
                <h3>{role.title}</h3>
                <p class="timeline-meta">
                  <span class="timeline-company">{role.company}</span>
                  <span class="timeline-period">{role.period}</span>
                </p>
              </div>
              {
                role.links && (
                  <ul class="timeline-links">
                    {role.links.map((link) => (
                      <li>
                        <a href={link.url} target="_blank" rel="noreferrer">
                          {link.label}
                        </a>
                      </li>
                    ))}
                  </ul>
                )
              }
            </div>
            <p class="timeline-summary">{role.summary}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="section" id="ai" aria-labelledby="ai-title">
    <h2 id="ai-title">{aiSection.title}</h2>
    {
      aiSection.paragraphs.map((paragraph) => (
        <p class="prose">{paragraph}</p>
      ))
    }
  </section>

  <section class="section contact-section" id="contact" aria-labelledby="contact-title">
    <h2 id="contact-title">{contactSection.title}</h2>
    <p class="section-intro">{contactSection.intro}</p>
    <ul class="contact-list">
      <li>
        <a href={site.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      </li>
      <li>
        <a href={site.github} target="_blank" rel="noreferrer">GitHub</a>
      </li>
      <li>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </li>
      <li>
        <a href={site.resumePdf} download={resumeDownloadName}>Resume (PDF)</a>
      </li>
    </ul>
  </section>
</BaseLayout>
